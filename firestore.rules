rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasPermission(perm) {
      return get(/databases/$(database)/documents/user/$(request.auth.uid)).data.permissions.hasAny([perm]);
    }

    // True when the write touches nothing outside the listed fields
    function changesOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /user/{userId} {
      // 'attendance' needs the member list for the attendance viewer and member search
      allow read: if request.auth.uid == userId
                  || hasPermission('profile')
                  || hasPermission('attendance')
                  || hasPermission('admin');
      // A new user may only create their own profile, with no permissions
      allow create: if request.auth.uid == userId
                    && request.resource.data.permissions is list
                    && request.resource.data.permissions.size() == 0;
      // Contact details: the member themselves, or anyone with 'profile'.
      // Permissions: only 'admin' — which can grant anything, including 'admin'.
      allow update: if (changesOnly(['name', 'phone', 'email2'])
                        && (request.auth.uid == userId || hasPermission('profile')))
                    || (hasPermission('admin')
                        && changesOnly(['name', 'phone', 'email2', 'permissions'])
                        && request.resource.data.permissions is list);
    }

    // Everyone signed in reads announcements; 'announcement' publishes, edits and removes them
    match /announcement/{announcementId} {
      allow read: if request.auth != null;
      allow create: if hasPermission('announcement')
                    && request.resource.data.title is string
                    && request.resource.data.content is string
                    && request.resource.data.publishedAt == request.time;
      // An edit never moves the published time
      allow update: if hasPermission('announcement')
                    && request.resource.data.title is string
                    && request.resource.data.content is string
                    && request.resource.data.publishedAt == resource.data.publishedAt;
      allow delete: if hasPermission('announcement');
    }

    // Club attendance settings: weekly training schedule + check-in window length
    match /config/attendance {
      allow read, write: if hasPermission('attendance');
    }

    match /session/{sessionId} {
      allow read: if request.auth != null;
      allow write: if hasPermission('attendance');
    }

    match /sessionSecret/{sessionId} {
      allow read, write: if hasPermission('attendance');
    }

    // Member check-ins are written by the submitAttendance Cloud Function
    // (admin SDK bypasses these rules) — members have no direct write access.
    match /attendance/{userId}/sessions/{sessionId} {
      allow read: if request.auth.uid == userId || hasPermission('attendance');
      // Admins can manually mark someone as attended
      allow create: if hasPermission('attendance');
    }
  }
}
